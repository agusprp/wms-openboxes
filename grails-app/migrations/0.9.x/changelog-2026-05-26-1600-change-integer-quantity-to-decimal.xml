<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <changeSet id="OBWMS-20260526-1600-1" author="wms-team">
        <comment>Change Integer quantity columns to decimal(19,3) for decimal quantity support</comment>

        <!-- Inventory -->
        <modifyColumn tableName="inventory_snapshot">
            <column name="quantity_on_hand" type="decimal(19,3)"/>
            <column name="quantity_inbound" type="decimal(19,3)"/>
            <column name="quantity_outbound" type="decimal(19,3)"/>
        </modifyColumn>

        <modifyColumn tableName="inventory_item_snapshot">
            <column name="quantity_on_hand" type="decimal(19,3)"/>
            <column name="quantity_inbound" type="decimal(19,3)"/>
            <column name="quantity_outbound" type="decimal(19,3)"/>
            <column name="quantity_available_to_promise" type="decimal(19,3)"/>
        </modifyColumn>

        <modifyColumn tableName="transaction_entry">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Order -->
        <modifyColumn tableName="order_item">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Shipping -->
        <modifyColumn tableName="shipment_item">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>

        <modifyColumn tableName="fulfillment_item">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Receiving -->
        <modifyColumn tableName="receipt_item">
            <column name="quantity_shipped" type="decimal(19,3)"/>
            <column name="quantity_received" type="decimal(19,3)"/>
            <column name="quantity_canceled" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Requisition -->
        <modifyColumn tableName="requisition_item">
            <column name="quantity" type="decimal(19,3)"/>
            <column name="quantity_counted" type="decimal(19,3)"/>
            <column name="quantity_approved" type="decimal(19,3)"/>
            <column name="quantity_canceled" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Product -->
        <modifyColumn tableName="product_package">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>

        <modifyColumn tableName="product_availability">
            <column name="quantity_on_hand" type="decimal(19,3)"/>
            <column name="quantity_allocated" type="decimal(19,3)"/>
            <column name="quantity_on_hold" type="decimal(19,3)"/>
            <column name="quantity_available_to_promise" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Picklist -->
        <modifyColumn tableName="picklist_item">
            <column name="quantity" type="decimal(19,3)"/>
            <column name="quantity_picked" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Cycle Count -->
        <modifyColumn tableName="cycle_count_item">
            <column name="quantity_on_hand" type="decimal(19,3)"/>
            <column name="quantity_counted" type="decimal(19,3)"/>
        </modifyColumn>

        <!-- Invoice -->
        <modifyColumn tableName="invoice_item">
            <column name="quantity" type="decimal(19,3)"/>
        </modifyColumn>
    </changeSet>
</databaseChangeLog>
